    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "~29.5",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "~8.57",
    "jest": "~29.7",
    "ts-jest": "~29.1",
    "typescript": "~5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
